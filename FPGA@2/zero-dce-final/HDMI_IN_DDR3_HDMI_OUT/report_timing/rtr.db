            <data>Declared</data>
            <data>37.0000</data>
            <data>27.0270MHz</data>
            <data>0.0000</data>
            <data>18.5000</data>
            <data>148</data>
            <data>2</data>
            <data/>
            <data>{ sys_clk }</data>
